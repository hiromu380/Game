# ローカル開発用の秘密値の見本。.dev.vars にコピーして値を変えて使う（.dev.vars は git 管理外）
# 本番は `wrangler secret put <名前>` で設定する（docs/ops/deploy.md）
DAILY_MASTER_SECRET=local-dev-secret-change-me-0123456789abcdef
# Turnstile: Cloudflare 公式のテスト用秘密キー（常に成功する）。本番は管理画面で発行したキー
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# 開発時は Vite のプロキシで同一オリジンになるので CORS は不要。別オリジンから呼ぶときだけ指定する
# CORS_ORIGINS=http://localhost:5173
# Steam のパブリッシャーキー（本番は `wrangler secret put STEAM_WEB_API_KEY`）。
# 未設定なら Steam 認証は serviceUnavailable を返す（Web 版の匿名登録は影響を受けない）
# STEAM_WEB_API_KEY=
# 開発用の時計: POST /api/dev/clock で時刻を進められる（週の切り替え・結果発表の確認用。docs/ops/weekly.md）。
# 本番では設定しない（localhost 以外からの呼び出しも拒否する）
DEV_CLOCK=1
