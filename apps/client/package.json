{
  "name": "@chain-factory/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web版クライアント（Vite + PixiJS + React）",
  "scripts": {
    "dev": "vite",
    "dev:capture": "vite --mode capture",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "tsc -p tsconfig.json --noEmit && vite build --mode demo",
    "build:capture": "tsc -p tsconfig.json --noEmit && vite build --mode capture",
    "preview": "vite preview",
    "ui-review": "tsx build/ui-review/capture.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "art": "tsx art/build.ts"
  },
  "dependencies": {
    "@chain-factory/shared": "workspace:*",
    "@chain-factory/sim": "workspace:*",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.1"
  }
}
